VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 이벤트 적재 방식: table(DB row) | storage(오브젝트 배치, 기본 table)
VITE_ANALYTICS_SINK=table

# 로그 수집 (기본 true)
VITE_ANALYTICS_ENABLED=true
# 세션 녹화 (기본 false)
VITE_ANALYTICS_RECORDING=false
# 녹화 샘플링 비율 0~1 (기본 1)
VITE_ANALYTICS_RECORDING_SAMPLE_RATE=1
